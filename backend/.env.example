# App
PROJECT_NAME="Finance App API"
API_V1_PREFIX="/api/v1"

# Database
# Local dev (default): SQLite, no extra services needed
DATABASE_URL="sqlite+aiosqlite:///./finance_app.db"
# PostgreSQL (used by docker-compose):
# DATABASE_URL="postgresql+asyncpg://finance:finance@db:5432/finance_app"

# Security / JWT — CHANGE SECRET_KEY IN PRODUCTION
SECRET_KEY="change-me-in-production-please-use-a-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated origins, or * for all
BACKEND_CORS_ORIGINS="*"
